# VirtualMeet Environment Variables — for `docker compose` only.
# Copy this file to .env in the repo root; docker-compose.yml reads it for
# ${VAR} substitution (e.g. JWT_SECRET) when building/running the stack.
#
# Running the server directly with `npm run dev` / `npm start` (no Docker)?
# That does NOT read this file — see server/.env.example instead, since
# dotenv loads server/.env there (npm sets the workspace dir as cwd).

# ── Server ────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kaispace

# ── Redis (optional, falls back to in-memory) ─
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────
JWT_SECRET=change-this-to-a-random-string
JWT_EXPIRES_IN=30d

# ── CORS ──────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ── Google OAuth (optional — "Login dengan Google", Basic: email+profil) ─
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (type: Web application). GOOGLE_REDIRECT_URI must exactly match the one
# registered in Console AND end in /api/auth/google/callback (nginx only
# proxies /api/ to the backend). GOOGLE_LOGIN_ENABLED must be the literal
# string "true" to show the button — leave blank to keep it hidden even if
# the credentials below are already filled in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_LOGIN_ENABLED=

# ── Operator (optional) ───────────────────────────────────────────────
# Comma-separated emails allowed to see the cross-org organization list
# (client/src/operator/OperatorConsole.tsx). Unset/empty = nobody has
# access. See server/src/lib/operator.ts.
OPERATOR_EMAILS=

# ── Music Bot (!play chat command, YouTube search) ─
# See server/.env.example for how to obtain a key. Leave blank -> Music Bot
# replies "belum dikonfigurasi" in chat instead of crashing.
YOUTUBE_API_KEY=
