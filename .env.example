# KaiSpace — environment for `docker compose` ONLY.
#
# Copy to .env in the repo root. docker-compose.yml reads this file for
# ${VAR} substitution; it does NOT get mounted into the container, so a
# variable only reaches the app if docker-compose.yml forwards it explicitly.
# Everything listed below is forwarded — anything you add here that isn't in
# docker-compose.yml's `environment:` block is silently ignored.
#
# Running the server directly with `npm run dev` / `npm start` (no Docker)?
# This file is not read at all — see server/.env.example instead, since
# dotenv loads server/.env there (npm sets the workspace dir as cwd).

# ── Public address ────────────────────────────
# THE one setting to change when deploying to a new domain. It fills in
# CLIENT_URL and CORS_ORIGIN for the server, and VITE_SERVER_URL baked into
# the client bundle at build time — which is why changing it requires a
# rebuild (`docker compose build`), not just a restart.
#
# Must be the address a browser actually uses, scheme included and no
# trailing slash: https://office.example.com
#
# Left unset it defaults to http://localhost:8091, matching the port the
# nginx service publishes on loopback. In production your VPS's own nginx
# terminates TLS for the real domain and proxies to 127.0.0.1:8091 — see
# deploy/deploy.md.
PUBLIC_URL=

# ── JWT ───────────────────────────────────────
# REQUIRED. The stack refuses to start without it, and the server refuses to
# boot when NODE_ENV=production and this is still a default-looking value.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# ── Google OAuth (optional — "Login dengan Google") ─
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (type: Web application). GOOGLE_REDIRECT_URI must exactly match the one
# registered in Console AND end in /api/auth/google/callback (nginx only
# proxies /api/ to the backend), so on a new domain it becomes
# https://<domain-anda>/api/auth/google/callback — update it in BOTH places
# or the callback fails with redirect_uri_mismatch.
#
# GOOGLE_LOGIN_ENABLED is a separate switch from the credentials: set it to
# the literal string "true" to show the button, leave blank to keep it hidden
# even when the credentials below are filled in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_LOGIN_ENABLED=

# ── Operator (optional) ───────────────────────
# Comma-separated emails allowed to see the cross-org organization list
# (client/src/operator/OperatorConsole.tsx). Unset/empty = nobody has access.
OPERATOR_EMAILS=

# ── Music Bot (optional — !play chat command) ─
# YouTube Data API v3 key. See server/.env.example for how to obtain one.
# Leave blank → the bot replies "belum dikonfigurasi" instead of crashing.
YOUTUBE_API_KEY=

# ── Customer Service chat "Hubungi admin" (see server/.env.example for full docs) ─
# CS_ADMIN_WHATSAPP_NUMBER — wa.me deep link. International format, digits
# only, no leading + or 0 (e.g. 6281234567890). Leave blank to keep the
# button replying "belum tersedia" instead of crashing.
CS_ADMIN_WHATSAPP_NUMBER=

# ── TURN relay (voice/video fallback) ─────────────
# Read at BUILD time as docker-compose build args for the client image (see
# client/Dockerfile) — so changing these needs `docker compose build nginx`,
# not just a restart. Left blank, the client ships with Google STUN ONLY, and
# every pair of users who cannot find a direct path — symmetric NAT, a
# corporate firewall that drops UDP, mobile CGNAT — silently never connects.
# There is no error for that anywhere: those two people simply never hear each
# other, in every session, because their network is the same every day. This
# was blank in production for exactly that reason: nothing here said it
# existed.
#
# Values must match the coturn config: VITE_TURN_USERNAME/CREDENTIAL are the
# `user=name:password` pair, and the host/port its `listening-port`. List both
# transports (comma-separated, the client splits on it) — the TCP one is what
# gets through networks that drop UDP entirely:
#   turn:HOST:3478?transport=udp,turn:HOST:3478?transport=tcp
#
# The credential ends up inside the browser bundle, so it is PUBLIC. coturn
# must therefore refuse to relay into private ranges (denied-peer-ip for
# 10/8, 172.16/12, 192.168/16, 127/8, 169.254/16) or anyone reading it can
# use this server to reach the inside of your network. A server-minted
# short-lived credential (coturn's use-auth-secret) is the real fix.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# ── RustDesk relay (Remote Help) ──────────────────
# Same BUILD-time rule as the TURN block above: docker-compose build args for
# the client image, so a change needs `docker compose build nginx`, not a
# restart. Left blank, Remote Help has no relay to reach and simply does not
# work — quietly, the same way a blank TURN config does.
#
# These lived only as an uncommitted edit on the prod host for a while, with
# the values written inline in docker-compose.yml, which meant a plain
# `git checkout` there would have switched Remote Help off with nothing
# anywhere saying why. They are read from this file now instead.
#
# ID and RELAY are the hbbs/hbbr host (usually the same address); KEY is the
# RustDesk server's PUBLIC key, the one clients are meant to be given. Like
# every VITE_ var it is inlined into the browser bundle, so treat it as
# public — the server's private key never belongs here.
VITE_RUSTDESK_ID_SERVER=
VITE_RUSTDESK_RELAY_SERVER=
VITE_RUSTDESK_KEY=

# ── LiveKit SFU ───────────────────────────────────
# The media server that replaces the in-browser mesh (see deploy/livekit/).
# Server-side only — unlike the VITE_ vars above, none of these reach a
# browser, and the secret in particular signs every join credential: anyone
# holding it can mint a token for any room, so it must never be logged.
#
# Leave all three blank and nothing changes: POST /api/livekit/token answers
# 503 and the app keeps using the mesh exactly as before. That is what lets
# this ship long before the client knows LiveKit exists.
#
# KEY and SECRET are the pair generated on the LiveKit host — read them with
#   ssh livekit "cat /opt/livekit/.env"
# where they are stored as a single "LIVEKIT_KEYS=<key>: <secret>" line.
#
# URL is handed to the browser alongside its token rather than compiled into
# the bundle, so moving the SFU is a server restart and not a rebuild. The
# VITE_TURN_* block above is what happens when that goes the other way.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Which rooms use LiveKit instead of the in-browser mesh. Comma-separated room
# slugs; blank — the shipped default — means every room stays on the mesh and
# none of the LiveKit client code is reachable.
#
# Per room, never a global switch, because the two cannot interoperate: a
# browser publishing to an SFU and a browser offering a peer connection have
# nothing to say to each other. A room is entirely on one or entirely on the
# other, and switching one over cannot affect anybody in a different room.
#
# That mechanism is not caution for its own sake. Landing the m-line fix
# during working hours killed every pair where one side had the old bundle and
# the other the new, and it had to be reverted within the hour. There is no
# version of mesh-to-SFU that survives being switched on for everyone at once.
#
# BUILD-time, like the VITE_TURN_ block above: changing it needs
# `docker compose build nginx`, not a restart.
#
#   VITE_LIVEKIT_ROOMS=uji     one test room
#   VITE_LIVEKIT_ROOMS=uji,dcm two
#   VITE_LIVEKIT_ROOMS=*       everything, for the final migration
VITE_LIVEKIT_ROOMS=

# ── NOT configurable here ─────────────────────
# docker-compose.yml hardcodes these for the containerised stack, so setting
# them in this file has no effect:
#   NODE_ENV     — always "production" in the server container
#   DATABASE_URL — always the compose `postgres` service
#   REDIS_URL    — always the compose `redis` service
#   PORT         — the server listens on its default inside the container;
#                  the published port is set by the nginx service instead
