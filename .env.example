# VirtualMeet Environment Variables — for `docker compose` only.
# Copy this file to .env in the repo root; docker-compose.yml reads it for
# ${VAR} substitution (e.g. JWT_SECRET) when building/running the stack.
#
# Running the server directly with `npm run dev` / `npm start` (no Docker)?
# That does NOT read this file — see server/.env.example instead, since
# dotenv loads server/.env there (npm sets the workspace dir as cwd).

# ── Server ────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/virtualmeet

# ── Redis (optional, falls back to in-memory) ─
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────
JWT_SECRET=change-this-to-a-random-string
JWT_EXPIRES_IN=30d

# ── CORS ──────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ── Lark OAuth (optional — "Login dengan Lark") ─
# From Lark Open Platform (larksuite.com). Leave blank to disable the button.
# LARK_REDIRECT_URI must exactly match the one registered in Lark AND end in
# /api/auth/lark/callback (nginx only proxies /api/ to the backend).
LARK_APP_ID=
LARK_APP_SECRET=
LARK_REDIRECT_URI=
