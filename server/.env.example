# VirtualMeet Server Environment Variables — for local, non-Docker dev.
# Copy this file to server/.env — `npm run dev` / `npm start` load it via
# dotenv, which resolves relative to the process cwd (the `server/` folder,
# since npm sets that as cwd when running a workspace script).
#
# Running via `docker compose` instead? This file isn't read at all — see
# the root .env.example, which docker-compose.yml reads for variable
# substitution.

# ── Server ────────────────────────────────────
NODE_ENV="development"
PORT=3001

# ── Database ──────────────────────────────────
# Matches docker-compose.yml's postgres service credentials — works as-is
# against `docker compose up -d postgres`. Change USER/PASSWORD/db name only
# if you're pointing at a different Postgres instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/virtualmeet"

# ── Redis (optional, falls back to in-memory) ─
REDIS_URL="redis://localhost:6379"

# ── JWT ───────────────────────────────────────
# Required to be a real secret when NODE_ENV=production — the server
# refuses to boot with the default value in that case.
JWT_SECRET="change-this-to-a-random-string-at-least-32-chars"
# 30d default — GET /auth/me also silently reissues a fresh token once the
# current one is within 3 days of expiring, so a regularly-active user's
# session effectively never expires. Shorten this per-deployment if a
# stricter session lifetime is required.
JWT_EXPIRES_IN="30d"

# ── CORS ──────────────────────────────────────
CORS_ORIGIN="http://localhost:5173"
CLIENT_URL="http://localhost:5173"

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ── Lark OAuth (optional — "Login dengan Lark") ─
# From Lark Open Platform (larksuite.com). Leave blank to disable the button.
# LARK_REDIRECT_URI must exactly match the one registered in Lark AND end in
# /api/auth/lark/callback (nginx only proxies /api/ to the backend).
LARK_APP_ID=
LARK_APP_SECRET=
LARK_REDIRECT_URI=
LARK_ATTENDANCE_CREATOR_ID=

# ── Lark ↔ MeetKai two-way chat sync (Bagian 4) ─
# Inbound events use Lark's "long connection" (persistent WebSocket) mode via
# the official SDK — no webhook URL, encrypt key, or verification token needed.
# It reuses LARK_APP_ID/LARK_APP_SECRET above. In Lark Console → Events &
# Callbacks, set subscription mode to "long connection" and subscribe to
# im.message.receive_v1. Scopes: im:message, im:chat:readonly,
# contact:user.base:readonly.
#
# Bagian 4 upgrade — to relay chat to Lark AS the real user (not the bot), each
# user's Lark OAuth tokens are stored encrypted with this key (AES-256-GCM).
# Any non-empty string works (it's hashed to 32 bytes); generate one with
# `openssl rand -hex 32`. Leave blank to disable user-identity sending (chat
# then always relays via the bot with a [Name] prefix). Also add the
# im:message.send_as_user scope in the Lark Console.
LARK_TOKEN_ENC_KEY=
