# VirtualMeet Server Environment Variables — for local, non-Docker dev.
# Copy this file to server/.env — `npm run dev` / `npm start` load it via
# dotenv, which resolves relative to the process cwd (the `server/` folder,
# since npm sets that as cwd when running a workspace script).
#
# Running via `docker compose` instead? This file isn't read at all — see
# the root .env.example, which docker-compose.yml reads for variable
# substitution.

# ── Server ────────────────────────────────────
NODE_ENV="development"
PORT=3001

# ── Database ──────────────────────────────────
# Matches docker-compose.yml's postgres service credentials — works as-is
# against `docker compose up -d postgres`. Change USER/PASSWORD/db name only
# if you're pointing at a different Postgres instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/virtualmeet"

# ── Redis (optional, falls back to in-memory) ─
REDIS_URL="redis://localhost:6379"

# ── JWT ───────────────────────────────────────
# Required to be a real secret when NODE_ENV=production — the server
# refuses to boot with the default value in that case.
JWT_SECRET="change-this-to-a-random-string-at-least-32-chars"
# 30d default — GET /auth/me also silently reissues a fresh token once the
# current one is within 3 days of expiring, so a regularly-active user's
# session effectively never expires. Shorten this per-deployment if a
# stricter session lifetime is required.
JWT_EXPIRES_IN="30d"

# ── CORS ──────────────────────────────────────
CORS_ORIGIN="http://localhost:5173"
CLIENT_URL="http://localhost:5173"

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
