# VirtualMeet Server Environment Variables — for local, non-Docker dev.
# Copy this file to server/.env — `npm run dev` / `npm start` load it via
# dotenv, which resolves relative to the process cwd (the `server/` folder,
# since npm sets that as cwd when running a workspace script).
#
# Running via `docker compose` instead? This file isn't read at all — see
# the root .env.example, which docker-compose.yml reads for variable
# substitution.

# ── Server ────────────────────────────────────
NODE_ENV="development"
PORT=3001

# ── Database ──────────────────────────────────
# Matches docker-compose.yml's postgres service credentials — works as-is
# against `docker compose up -d postgres`. Change USER/PASSWORD/db name only
# if you're pointing at a different Postgres instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kaispace"

# ── Redis (optional, falls back to in-memory) ─
REDIS_URL="redis://localhost:6379"

# ── JWT ───────────────────────────────────────
# Required to be a real secret when NODE_ENV=production — the server
# refuses to boot with the default value in that case.
JWT_SECRET="change-this-to-a-random-string-at-least-32-chars"
# 30d default — GET /auth/me also silently reissues a fresh token once the
# current one is within 3 days of expiring, so a regularly-active user's
# session effectively never expires. Shorten this per-deployment if a
# stricter session lifetime is required.
JWT_EXPIRES_IN="30d"

# ── CORS ──────────────────────────────────────
CORS_ORIGIN="http://localhost:5173"
CLIENT_URL="http://localhost:5173"

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ── Google OAuth (optional — "Login dengan Google", Basic: email+profil) ─
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (type: Web application). GOOGLE_REDIRECT_URI must exactly match the one
# registered in Console AND end in /api/auth/google/callback (nginx only
# proxies /api/ to the backend). GOOGLE_LOGIN_ENABLED is a separate switch
# from the credentials below — set it to the literal string "true" to show
# the button; leave it unset/anything else to keep the button hidden even
# if credentials are already filled in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_LOGIN_ENABLED=

# ── Operator (optional) ───────────────────────────────────────────────
# Comma-separated emails allowed to see the cross-org organization list
# (client/src/operator/OperatorConsole.tsx). Unset/empty = nobody has
# access. See server/src/lib/operator.ts.
OPERATOR_EMAILS=

# ── Music Bot (!play chat command, YouTube search) ─
# Cara dapatnya:
#   1. Buka https://console.cloud.google.com/ , buat project baru (atau pakai
#      yang sudah ada).
#   2. Buka "APIs & Services" -> "Library", cari "YouTube Data API v3", klik
#      Enable.
#   3. Buka "APIs & Services" -> "Credentials" -> "Create Credentials" ->
#      "API key". Copy key-nya ke sini.
#   4. (Disarankan) Batasi API key itu supaya hanya bisa dipakai untuk
#      YouTube Data API v3, lewat "Restrict Key" di halaman credentials.
# Kuota gratis default: 10,000 unit/hari. Satu !play memakai 100 unit
# (search) + 1 unit (lookup durasi) = 101 unit, jadi ~99 pencarian/hari.
# Leave blank -> Music Bot membalas "belum dikonfigurasi" di chat, tidak crash.
YOUTUBE_API_KEY=

# Customer Service chat handoff (n8n <-> WhatsApp bridge, see routes/cs.ts).
# Ini BUKAN kredensial dari pihak ketiga — dua-duanya kamu yang menentukan
# sendiri, lalu dipakai di DUA tempat yang harus SAMA PERSIS:
#   1. Di sini (server MeetKai).
#   2. Di workflow n8n-mu, pada node HTTP Request yang memanggil balik
#      POST https://<domain-mu>/api/cs/reply — token di atas harus ikut
#      dikirim di body JSON-nya: { "token": "<CS_N8N_TOKEN>", ... }.
# N8N_CS_WEBHOOK_URL — alamat webhook n8n yang MENERIMA pesan dari MeetKai
# (n8n yang membuat URL ini, biasanya lewat node Webhook di workflow-mu).
N8N_CS_WEBHOOK_URL=
# CS_N8N_TOKEN — secret yang kamu buat sendiri (bukan dari n8n), dipakai
# MeetKai untuk memverifikasi bahwa POST /api/cs/reply beneran datang dari
# n8n-mu, bukan orang lain yang menebak endpoint-nya. Contoh cara bikin:
#   openssl rand -hex 32
# Leave blank -> fitur "Hubungi admin" membalas "belum tersedia", tidak crash.
CS_N8N_TOKEN=
