generator client {
  provider = "prisma-client-js"
  // omitApi: lets lib/prisma.ts globally `omit` the Lark token columns so they
  // never appear in a query result unless explicitly re-selected (Bagian 4).
  previewFeatures = ["omitApi"]
  // "native" covers local dev; "linux-musl-openssl-3.0.x" is the engine the
  // production Docker image (node:20-alpine) needs. Committed here so the VPS
  // no longer needs a local uncommitted edit that blocked every `git pull`.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                    @id @default(cuid())
  email                   String                    @unique
  password                String
  displayName             String
  avatarConfig            Json?
  // Chat profile photo, stored as a data-URL string (client resizes+compresses
  // to <=256px WebP, ~<100KB, before it ever reaches here). Deliberately a
  // heavy TEXT column kept OUT of hot queries via Prisma `omit`/explicit
  // `select` — see routes/users.ts. This base64-in-DB shortcut is ONLY for the
  // small profile photo; chat attachments/recordings must still go to object
  // storage (R2), never here.
  profilePhoto            String?                   @db.Text
  // Set for accounts created via "Login with Lark" (OAuth) — the Lark user's
  // open_id. Nullable + unique: existing manual-login users all have null (no
  // clash), and a given Lark identity maps to exactly one local account
  // (find-or-create keys on this). A Lark account's `password` is a random
  // unusable value (never a real hash), so it can't be used for manual login
  // unless the user later sets one — out of scope here. See routes/lark.ts.
  larkOpenId              String?                   @unique
  // Lark `user_id` (a.k.a. employee_id) — needed by the Attendance API, which
  // does NOT accept open_id. Captured at login when Lark returns it, else
  // resolved once from open_id via the contact API. Not unique (nullable, and
  // manual users don't have it). See lib/larkAttendance.ts.
  larkUserId              String?
  // Idempotency marker ONLY (not the source of truth — that's Lark Attendance):
  // 'YYYY-MM-DD' in WIB of the last day we successfully punched check-in for
  // this user, so repeated /auth/me hits the same day don't re-punch.
  lastAttendanceCheckInDate String?
  // Same idea for check-out (A12): 'YYYY-MM-DD' WIB of the last successful
  // checkout punch from MeetKai — a fast idempotency guard against double
  // checkout. Display/status is read live from Lark (user_tasks/query), which
  // also reflects checkouts done in the Lark app itself.
  lastAttendanceCheckOutDate String?
  // Bagian 4 upgrade — the user's own Lark OAuth tokens, so chat messages can
  // be sent to Lark AS the real user (im:message.send_as_user) instead of the
  // bot. SENSITIVE: these are impersonation credentials — stored AES-256-GCM
  // encrypted (see lib/tokenCrypto.ts), and excluded from every query by a
  // global Prisma `omit` (see lib/prisma.ts) so they can never leak to the
  // frontend; only the send path re-selects them explicitly. Captured/rotated
  // at Lark login (routes/lark.ts) and on refresh (lib/larkUserToken.ts).
  // Null for manual-login users → the bot+prefix fallback handles them.
  larkUserAccessToken   String?   @db.Text
  larkRefreshToken      String?   @db.Text
  // When the access token / refresh token expire (absolute instants). Not
  // secret, so not omitted — used to decide "still valid?" vs "refresh" vs
  // "give up and use the bot".
  larkTokenExpiresAt    DateTime?
  larkRefreshExpiresAt  DateTime?
  // Bug 1 — single active session. Random id minted at each successful login
  // (manual OR Lark) and embedded in the JWT as a `sessionId` claim. Auth
  // (REST + socket) rejects a token whose sessionId != this, so logging in on a
  // new device supersedes the old one. Null = legacy/no login since the feature
  // launched (grace-accepted, then adopted on the next /auth/me). Sliding
  // refresh keeps the SAME id so the same device stays logged in.
  currentSessionId      String?
  // Global, account-level role — separate from the per-room Role hierarchy
  // (owner/admin/staff/member, see shared/permissions.ts and RoomMember.role
  // below). 'admin' accounts can create rooms (the only account-wide gate;
  // everyone else can only join rooms that already exist) and are also
  // auto-elevated to at least room-level 'admin' in every room they're in,
  // without needing a RoomMember grant — see server/src/lib/roles.ts's
  // resolveRoomRole. Deletion stays owner-only regardless: a global admin
  // is NOT auto-elevated to 'owner' of rooms they didn't create.
  accountRole             String                    @default("user")
  // Workspace (organisation) role — a THIRD, independent layer from both
  // accountRole above and RoomMember.role. See shared/workspacePermissions.ts.
  // Deliberately NOT merged with accountRole: that one means "may create
  // rooms", which is far narrower than "may configure the whole workspace,
  // set shift rules, and read everyone's attendance".
  workspaceRole           String                    @default("member")
  // IANA zone (e.g. "Asia/Jakarta"). All timestamps are stored UTC in the DB
  // and rendered in this zone — Calendar and Attendance both depend on it.
  timezone                String                    @default("Asia/Jakarta")
  active                  Boolean                   @default(true)
  // QA #1/#6 — set once this account finishes the first-run tutorial
  // (App.tsx gates <Game> behind it while null). Never reset automatically —
  // "seen once" is permanent, same as most onboarding flows elsewhere.
  tutorialCompletedAt     DateTime?
  departmentId            String?
  department              Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  managerId               String?
  manager                 User?                     @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports                 User[]                    @relation("UserManager")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  auditEntries            AuditLog[]                @relation("AuditActor")
  auditTargets            AuditLog[]                @relation("AuditTargetUser")
  // Attendance module — reverse relations
  shiftAssignments        ShiftAssignment[]         @relation("ShiftUser")
  attendanceRecords       AttendanceRecord[]        @relation("AttendanceUser")
  leaves                  Leave[]                   @relation("LeaveUser")
  leavesApproved          Leave[]                   @relation("LeaveApprover")
  corrections             Correction[]              @relation("CorrectionUser")
  correctionsApproved     Correction[]              @relation("CorrectionApprover")
  // Calendar module — reverse relations
  ownedCalendars          Calendar[]                @relation("CalendarOwner")
  calendarMemberships     CalendarMember[]          @relation("CalendarMemberUser")
  organizedEvents         CalendarEvent[]           @relation("EventOrganizer")
  eventInvites            EventAttendee[]           @relation("EventAttendeeUser")
  // Docs module — reverse relations
  ownedDocs               Doc[]                     @relation("DocOwner")
  ownedFolders            Folder[]                  @relation("FolderOwner")
  docComments             DocComment[]              @relation("DocCommentAuthor")
  docVersions             DocVersion[]              @relation("DocVersionAuthor")
  roomMembers             RoomMember[]
  roomQueueEntries        RoomQueueEntry[]
  reportsMade             UserReport[]              @relation("ReportReporter")
  reportsReceived         UserReport[]              @relation("ReportReported")
  ownedRooms              Room[]
  sentChatMessages        ChatMessage[]
  chatReads               ChatRead[]
  dmConversationsAsA      DirectConversation[]      @relation("DMUserA")
  dmConversationsAsB      DirectConversation[]      @relation("DMUserB")
  // Messenger migration step 2 — replaces the As-A/As-B pair above with one
  // membership list that isn't scoped to a room (see Conversation).
  conversationMemberships ConversationParticipant[]
  // Workspace notifications (attendance/calendar/reminder). Kept after the Base
  // feature was removed (A7) — the Base module was deleted but Notification is
  // shared by many features, so only its Base coupling was dropped.
  baseNotifications       Notification[]            @relation("NotifRecipient")
}

// ─── Workspace foundation (shared by Base / Calendar / Attendance / Docs) ───

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   User[]
}

// ONE audit table for every module. Anything a workspace admin does that
// touches someone else's data lands here — takeovers, attendance edits and
// reads, policy changes, role changes. Append-only by convention: there is
// no update/delete route, and there must never be one.
model AuditLog {
  id           String   @id @default(cuid())
  actorId      String
  actor        User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  // The workspace action performed — a WorkspaceAction from
  // shared/workspacePermissions.ts, or a module verb like 'base:transfer'.
  action       String
  // What was acted on: 'base' | 'doc' | 'attendance' | 'user' | 'policy' | ...
  targetType   String
  targetId     String?
  // Set when the subject is a person (attendance reads/edits, role changes)
  // so "who looked at whose data" is filterable without parsing `meta`.
  targetUserId String?
  targetUser   User?    @relation("AuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  // Free-form detail. For mutations this carries { before, after } so the
  // old value → new value is recoverable; for reads, what was queried.
  meta         Json?
  // Required by policy for attendance record edits — server rejects without it.
  reason       String?
  ip           String?
  createdAt    DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

// Item 13, "Tak Terpikir" checklist ("Panic/report user") — a user reporting
// another user's BEHAVIOR (not a room-scoped moderation action like Kick,
// which already exists and stays instant/self-service for admins). Reporting
// is deliberately open to every real member, not just admins — the person
// experiencing bad behavior is rarely the one holding the Kick button.
// Persisted (not just a fire-and-forget notification) so there is a durable
// record an admin can refer back to, even though — per product decision —
// there is no dedicated review dashboard yet; the admin Notification created
// alongside this row (see routes/users.ts) is the only surface today, and an
// admin acts on it manually (DM, kick, etc.) via tools that already exist.
model UserReport {
  id           String    @id @default(cuid())
  reporterId   String
  reporter     User      @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId   String
  reported     User      @relation("ReportReported", fields: [reportedId], references: [id], onDelete: Cascade)
  // Which room this happened in, if reported from inside one (the Report
  // action is also reachable from a DM/profile, where there's no room).
  roomSlug     String?
  reason       String    @db.Text
  status       String    @default("open") // open | reviewed | dismissed
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
  @@index([reportedId, createdAt])
}

// Workspace-wide policy, a single row (id = "singleton"). Admin-editable;
// enforced server-side. Base/Docs share-link limits live here so both the
// Base module and the future Docs module read one source of truth.
model WorkspacePolicy {
  id                       String   @id @default("singleton")
  // Base
  basePublicLinksAllowed   Boolean  @default(true)
  baseExportAllowed        Boolean  @default(true)
  // Docs (consumed by the Docs module; stored now so policy is one table)
  docsPublicLinksAllowed   Boolean  @default(true)
  docsLinkPasswordRequired Boolean  @default(false)
  // Max share-link lifetime in days for both; null = no cap.
  maxShareLinkDays         Int?
  updatedAt                DateTime @updatedAt
  updatedById              String?
}

// ─── Attendance ─────────────────────────────────────────────────────
// Every timestamp here is set by the SERVER (Date.now() on the server), never
// from the client — the browser clock is the number-one cheating vector, so
// nothing in this module ever trusts a client-supplied time.
//
// Location is stored ONLY at clock in/out, never continuously, and is purged
// after LOCATION_RETENTION_DAYS (see socket/attendanceSweep.ts). There is no
// movement history in this schema by design.

model Shift {
  id              String   @id @default(cuid())
  name            String
  // Wall-clock "HH:mm" in the shift's zone — NOT instants: a shift is
  // "09:00 every workday", which a UTC timestamp cannot express.
  startTime       String
  endTime         String
  timezone        String   @default("Asia/Jakarta")
  breakMinutes    Int      @default(60)
  graceMinutes    Int      @default(10)
  // ISO weekdays worked: 1 = Monday … 7 = Sunday
  workdays        Int[]    @default([1, 2, 3, 4, 5])
  // none | after_shift | manual
  overtimeRule    String   @default("after_shift")
  // Optional geofence. Validated SERVER-side; a null centre means no fence.
  geofenceLat     Float?
  geofenceLng     Float?
  geofenceRadiusM Int?
  // Optional office IP allowlist (CIDR or plain IPs).
  allowedIps      String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignments ShiftAssignment[]
  records     AttendanceRecord[]
}

model ShiftAssignment {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation("ShiftUser", fields: [userId], references: [id], onDelete: Cascade)
  shiftId       String
  shift         Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, effectiveFrom])
}

model AttendanceRecord {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  // The work DAY this belongs to, as a date in the shift's zone (stored at
  // 00:00 UTC of that local date) — a night shift crossing midnight still
  // belongs to one day.
  date              DateTime
  clockIn           DateTime?
  clockOut          DateTime?
  shiftId           String?
  shift             Shift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  // ontime | late | early_leave | absent | leave | holiday | auto_closed
  status            String    @default("absent")
  workMinutes       Int       @default(0)
  overtimeMinutes   Int       @default(0)
  // Captured at the moment of clock in/out only. Purged by the retention sweep.
  clockInLat        Float?
  clockInLng        Float?
  clockInAccuracyM  Float?
  clockOutLat       Float?
  clockOutLng       Float?
  clockOutAccuracyM Float?
  locationPurgedAt  DateTime?
  clockInMethod     String    @default("web")
  clockInIp         String?
  note              String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  corrections Correction[]

  @@unique([userId, date])
  @@index([date])
}

model LeaveType {
  id               String   @id @default(cuid())
  name             String   @unique
  quotaPerYear     Int      @default(12)
  paid             Boolean  @default(true)
  requiresApproval Boolean  @default(true)
  createdAt        DateTime @default(now())

  leaves Leave[]
}

model Leave {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("LeaveUser", fields: [userId], references: [id], onDelete: Cascade)
  typeId       String
  type         LeaveType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  startDate    DateTime
  endDate      DateTime
  halfDay      Boolean   @default(false)
  reason       String
  status       String    @default("pending") // pending | approved | rejected
  approverId   String?
  approver     User?     @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime  @default(now())

  @@index([userId, startDate])
  @@index([status])
}

model Correction {
  id                String           @id @default(cuid())
  recordId          String
  record            AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  userId            String
  user              User             @relation("CorrectionUser", fields: [userId], references: [id], onDelete: Cascade)
  // What the member ASKS for — never applied directly; an approver decides.
  requestedClockIn  DateTime?
  requestedClockOut DateTime?
  reason            String
  status            String           @default("pending") // pending | approved | rejected
  approverId        String?
  approver          User?            @relation("CorrectionApprover", fields: [approverId], references: [id], onDelete: SetNull)
  decidedAt         DateTime?
  createdAt         DateTime         @default(now())

  @@index([userId, status])
  @@index([status])
}

model Holiday {
  id   String   @id @default(cuid())
  date DateTime @unique
  name String
}

// ─── Calendar ───────────────────────────────────────────────────────
// Times are stored as UTC instants (`start`/`end`). `timezone` is the zone the
// event was AUTHORED in — needed because a recurring 09:00 meeting must stay
// 09:00 local across a DST boundary, which a fixed UTC offset cannot express.
// Recurrence is an RFC 5545 RRULE string; instances are expanded on read, not
// stored — except overrides (see CalendarEvent.recurrenceId below).

model Calendar {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#a855f7")
  // personal | team | resource. Creating a `team` calendar is a workspace-admin
  // action (shared/workspacePermissions.ts: calendar:manageTeamCalendars).
  type      String   @default("personal")
  ownerId   String
  owner     User     @relation("CalendarOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members CalendarMember[]
  events  CalendarEvent[]

  @@index([ownerId])
}

model CalendarMember {
  id         String   @id @default(cuid())
  calendarId String
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("CalendarMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  role       String // editor | viewer (see shared/calendarPermissions.ts)
  createdAt  DateTime @default(now())

  @@unique([calendarId, userId])
  @@index([userId])
}

model MeetingRoom {
  id         String   @id @default(cuid())
  name       String
  capacity   Int      @default(4)
  location   String?
  equipment  String[] @default([])
  // Minimum workspace role allowed to book: 'member' (anyone) or 'admin'.
  bookableBy String   @default("member")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  events CalendarEvent[]
}

// A5 — a recorded "official meeting" started from inside a meeting-type Zone,
// backed by a Lark VC reservation (auto_record). Distinct from MeetingRoom
// (calendar room booking). Foundation for A6 (AI summary). Standalone (no FK
// relations) — roomId is the room slug, startedBy/zoneId are plain ids.
model MomRecord {
  id              String    @id @default(cuid())
  roomId          String
  zoneId          String
  startedBy       String
  startTime       DateTime  @default(now())
  endTime         DateTime?
  larkReserveId   String?
  larkMeetingNo   String?
  larkMeetingId   String?
  // 'live' → meeting reserved/ongoing; 'ended' → ended, no recording yet;
  // 'recording_pending' → waiting on Lark to finish processing; 'recorded' →
  // recordingUrl filled; 'unavailable' → plan/permission has no recording.
  recordingStatus String    @default("live")
  recordingUrl    String?
  summary         String?   @db.Text
  actionItems     Json?
  createdAt       DateTime  @default(now())

  @@index([roomId])
}

model CalendarEvent {
  id          String       @id @default(cuid())
  calendarId  String
  calendar    Calendar     @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  title       String
  description String?
  // UTC instants. Always. Rendering happens in the viewer's zone.
  start       DateTime
  end         DateTime
  allDay      Boolean      @default(false)
  // IANA zone the event was authored in (e.g. "Asia/Jakarta").
  timezone    String       @default("Asia/Jakarta")
  location    String?
  roomId      String?
  room        MeetingRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  // RFC 5545 rule on the SERIES master (null for one-off events).
  rrule        String?
  // Set on an OVERRIDE row: points at the master and pins which occurrence it
  // replaces (`recurrenceId` = that occurrence's original UTC start). This is
  // how "edit only this event" works without materialising the whole series.
  masterId     String?
  master       CalendarEvent?  @relation("EventOverrides", fields: [masterId], references: [id], onDelete: Cascade)
  overrides    CalendarEvent[] @relation("EventOverrides")
  recurrenceId DateTime?
  // Occurrences removed from the series (by "delete only this" or by a
  // "this and following" split). Stored as their original UTC starts.
  exdates      DateTime[]      @default([])

  organizerId     String
  organizer       User    @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  visibility      String  @default("default") // default | private
  // Link back to a MeetKai room session started from this event.
  meetkaiRoomSlug String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendees EventAttendee[]
  reminders EventReminder[]

  @@index([calendarId, start])
  @@index([roomId, start])
  @@index([masterId])
}

model EventAttendee {
  id       String        @id @default(cuid())
  eventId  String
  event    CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId   String
  user     User          @relation("EventAttendeeUser", fields: [userId], references: [id], onDelete: Cascade)
  rsvp     String        @default("needsAction") // needsAction | accepted | declined | tentative
  optional Boolean       @default(false)

  @@unique([eventId, userId])
  @@index([userId])
}

model EventReminder {
  id            String        @id @default(cuid())
  eventId       String
  event         CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  minutesBefore Int
  method        String        @default("inapp") // inapp | email
  // Set once fired so the sweeper never double-notifies for the same instance.
  lastFiredFor  DateTime?

  @@index([eventId])
}

// ─── Docs (collaborative documents module) ──────────────────────────
// Content is a Yjs document, stored as its binary state vector in
// `content` — NOT as HTML/JSON. Yjs is the source of truth for the text so
// concurrent typing merges by CRDT instead of last-write-wins. The server
// keeps an authoritative Y.Doc per open document (see socket/docsHandler.ts)
// and persists snapshots of it here.

model Folder {
  id        String   @id @default(cuid())
  parentId  String?
  parent    Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderTree")
  name      String
  ownerId   String
  owner     User     @relation("FolderOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  docs      Doc[]

  @@index([ownerId])
  @@index([parentId])
}

model Doc {
  id          String   @id @default(cuid())
  folderId    String?
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  title       String   @default("Dokumen Tanpa Judul")
  icon        String?
  coverImage  String?
  // Yjs binary update (Y.encodeStateAsUpdate). Empty for a brand-new doc.
  content     Bytes?
  ownerId     String
  owner       User     @relation("DocOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  permissions DocPermission[]
  comments    DocComment[]
  versions    DocVersion[]
  shareLinks  DocShareLink[]

  @@index([ownerId, updatedAt])
  @@index([folderId])
}

// Per-doc access grant. subjectType 'user' is the only one wired today;
// 'team' is reserved for when departments become shareable subjects.
// Link-based access lives in DocShareLink, not here.
model DocPermission {
  id          String   @id @default(cuid())
  docId       String
  doc         Doc      @relation(fields: [docId], references: [id], onDelete: Cascade)
  subjectType String   @default("user") // user | team
  subjectId   String
  role        String // editor | commenter | viewer (see shared/docPermissions.ts)
  createdAt   DateTime @default(now())

  @@unique([docId, subjectType, subjectId])
  @@index([subjectId])
}

model DocShareLink {
  id           String    @id @default(cuid())
  token        String    @unique
  docId        String
  doc          Doc       @relation(fields: [docId], references: [id], onDelete: Cascade)
  role         String // viewer | commenter | editor
  passwordHash String?
  allowCopy    Boolean   @default(true)
  expiresAt    DateTime?
  lastOpenedAt DateTime?
  createdById  String
  createdAt    DateTime  @default(now())

  @@index([docId])
}

model DocComment {
  id         String       @id @default(cuid())
  docId      String
  doc        Doc          @relation(fields: [docId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     DocComment?  @relation("DocCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    DocComment[] @relation("DocCommentReplies")
  authorId   String
  author     User         @relation("DocCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  // Anchor into the text. The quoted excerpt is kept so a comment stays
  // legible even after the text it pointed at is edited away.
  anchorFrom Int?
  anchorTo   Int?
  quoted     String?
  resolved   Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([docId, resolved, createdAt])
}

model DocVersion {
  id          String   @id @default(cuid())
  docId       String
  doc         Doc      @relation(fields: [docId], references: [id], onDelete: Cascade)
  // Full Yjs state at snapshot time — restoring is "apply this update",
  // which keeps restore itself a normal CRDT merge rather than a clobber.
  content     Bytes
  name        String?
  // Plain-text rendering at snapshot time, so the version list and diffs
  // don't need to boot a Y.Doc per row.
  preview     String?
  createdById String?
  createdBy   User?    @relation("DocVersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([docId, createdAt])
}

// ─── Workspace notifications ─────────────────────────────────────────
// Shared by attendance / calendar / reminders / admin (each calls
// notification.create). Originally created alongside the Lark Base module and
// coupled to it via baseId; the Base feature was removed in A7, so that column
// and its FK were dropped, but the table itself stays — many features depend on
// it. `recordId` is a free-form pointer kept for legacy rows.
model Notification {
  id          String   @id @default(cuid())
  recipientId String
  recipient   User     @relation("NotifRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  kind        String // mention | assigned | invited
  body        String
  recordId    String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([recipientId, read, createdAt])
}

model Room {
  id                String               @id @default(cuid())
  name              String
  slug              String               @unique
  tilemapData       Json
  furniture         Json?
  zones             Json?
  // Which curated asset set the room renders with — see RoomTheme in
  // shared/types/index.ts. Default keeps every room created before this
  // field existed rendering exactly as before.
  theme             String               @default("scifi-office")
  // Which layout this room was created with (see shared/defaultRoomLayout.ts's
  // ROOM_TEMPLATES) — null for rooms created before this field existed, or
  // if none was specified (both cases fall back to 'main-office' at the
  // point of use). Lets RoomEditor's "Reset to Default" rebuild the room's
  // OWN template instead of always reverting to Main Office.
  template          String?
  ownerId           String
  owner             User                 @relation(fields: [ownerId], references: [id])
  isPublic          Boolean              @default(true)
  // Invite-link joins land in an admin approval queue instead of walking
  // straight in (see RoomMember.status). Separate from isPublic on purpose:
  // isPublic controls whether a room is LISTED, this controls whether
  // entering it needs a decision — an office can be findable and still not be
  // walk-in.
  //
  // Defaults true so every NEW room is approval-gated, which is the intent.
  // Rooms that already existed are backfilled to false by the migration:
  // silently locking 190 live rooms behind an empty approval queue would
  // strand everyone currently using them.
  requiresApproval  Boolean              @default(true)
  maxPlayers        Int                  @default(50)
  // QA (Akses ruang checklist item 1, "Ruang sensitif terkontrol") — a
  // STRICTER gate than requiresApproval above: when true, self-service
  // join-request is disabled entirely (no "needs-request" path at all, see
  // resolveEntry) — only someone who ALREADY holds a RoomMember row with
  // role >= restrictedMinRole (granted out-of-band by an admin, via the
  // Admin Console's room access manager) may enter. Owner/global-admin
  // always bypass, same as every other entry gate in this app. Separate
  // boolean (not just repurposing requiresApproval) so a room can flip
  // back to ordinary approval-gated without losing which specific people
  // were on the restricted allowlist.
  restrictedAccess   Boolean              @default(false)
  // Minimum RoomMember.role (see shared/permissions.ts's Role/ROLE_ORDER)
  // required to enter while restrictedAccess is on. 'staff' by default —
  // deliberately one tier above the ordinary 'member' every approved
  // join-request grants, so approving someone into a NORMAL room never
  // accidentally satisfies a DIFFERENT room's restriction.
  restrictedMinRole  String               @default("staff")
  // "Ngobrol dengan CEO" queue — only meaningful while restrictedAccess is
  // on. When true, someone denied by restrictedAccess sees a "join the
  // queue" form instead of a dead end (see resolveEntry's 'queue' reason);
  // when false (default), a restricted room behaves exactly as before —
  // admin-granted access only, no self-service path at all.
  queueEnabled      Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  members           RoomMember[]
  queueEntries      RoomQueueEntry[]
  zoneRestrictions  ZoneRestriction[]
  teleportLocations TeleportLocation[]
  ownerBookmarks    OwnerBookmark[]
  mediaObjects      MapMediaObject[]
  soundboardSounds  SoundboardSound[]
  recordings        Recording[]
  channels          Channel[]
  dmConversations   DirectConversation[]
  // Provenance back-relation only — these survive the room's deletion
  // (onDelete: SetNull), unlike everything else on this list.
  conversationsV2   Conversation[]
  // Bagian 4 — optional Lark group this room's "general" channel syncs with.
  larkChatMap       RoomChatMap?
  // A8 — Lark Drive folder (under LARK_DRIVE_ROOT_FOLDER_TOKEN) holding this
  // room's chat attachments + recordings. Created best-effort at room creation;
  // null until then (or if Drive isn't configured) — lazily created on first
  // upload (see lib/larkDrive.ensureRoomFolder), which also covers retry after
  // a failed create and rooms that predate this feature.
  larkFolderToken   String?
  // ZEP Room Editor (Potong 1) — new layered map format, stored BESIDE the
  // legacy tilemapData/furniture/zones columns (which stay as archive/fallback).
  // Nullable: a room without layerData still renders via the legacy path,
  // unchanged. Populated lazily (once, idempotently) the first time the room is
  // opened in the new editor — see lib/convertLegacyRoom.ts. Once set, it is the
  // room's source of truth and the game reads it via the layerDataToLegacy
  // adaptor. mapFormatVersion tracks the schema of layerData.
  layerData         Json?
  mapFormatVersion  Int?
  invites           RoomInvite[]
  deskNotes         DeskNote[]
}

// QA #7/#8/#9 — a sticky note placed on the map, same "Add Media, lands at
// your current tile" placement convention as image/whiteboard/file
// (AddMediaPanel.tsx) rather than attached to a specific furniture piece
// (an earlier pass tried the furniture-attached shape; moved off it per
// explicit follow-up request — freeform x/y like MapMediaObject instead).
// Deliberately its own table rather than a new MapMediaObject.type: 'note'
// row — MEDIA_REMOVE's permission (creator OR room owner/admin) doesn't
// match this feature's strict "Pembuat edit/hapus; lain baca saja" (author-
// only, no admin override), so reusing that table would mean fighting its
// existing permission assumptions instead of just adding a new type to it.
model DeskNote {
  id           String   @id @default(cuid())
  roomId       String
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  x            Int
  y            Int
  authorUserId String
  authorName   String
  text         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Guest Link & Ruang Tunggu — a room-scoped invite token an admin generates
// (POST /rooms/:slug/guest-invites) and hands out to an external person, who
// exchanges it (POST /guest/join, no auth) for a short-lived guest JWT — see
// server/src/routes/guestInvite.ts. Mirrors DocShareLink's token+expiresAt
// shape (the closest existing precedent), plus maxUses/useCount for
// one-time-use links. Never grants a real account — the guest identity lives
// entirely in the JWT (guestId, not a User row), so this table only tracks
// the LINK's own lifecycle, never who used it.
model RoomInvite {
  id            String    @id @default(cuid())
  token         String    @unique
  roomId        String
  room          Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdById   String
  createdByName String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime?
  maxUses       Int?
  useCount      Int       @default(0)
  revoked       Boolean   @default(false)

  @@index([roomId])
}

model RoomMember {
  userId   String
  roomId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())

  // Membership approval. 'active' is the default so every row that existed
  // before this column keeps working exactly as it did — this is additive,
  // it does not retroactively suspend anyone.
  //
  // 'pending' means the person followed an invite link into a room that
  // requires approval and is waiting on an admin. A pending row is NOT
  // membership: every access check treats it as "not a member", and it exists
  // only so the request is durable and shows up in the admin's queue.
  status     String    @default("active") // 'active' | 'pending' | 'rejected'
  requestedAt DateTime @default(now())
  // Who decided, and when — an audit trail for "why is this person in the
  // room", which is the question that actually gets asked later.
  decidedById String?
  decidedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])
  // The admin's pending queue for one room — the only query this column adds.
  @@index([roomId, status])
}

// "Ngobrol dengan CEO" queue — a timed, FIFO ticket for a restricted room
// (Room.restrictedAccess + queueEnabled). Deliberately its OWN admission
// mechanism, not a temporary RoomMember role grant: a queue slot is
// session-scoped and self-expiring by design, and reusing the persistent
// role-grant system for something meant to auto-revoke would mean either
// polluting real role data with transient state or building a second
// "temporary" flag on top of it anyway.
//
// Status lifecycle: waiting -> called -> active -> done
//                       \-> cancelled   \-> skipped (no-show past the call
//                                            grace period, or admin skip)
// 'called' means "your turn — come in", but the clock does not start until
// you actually walk in (resolveEntry/JOIN_ROOM flips called -> active the
// moment entry is granted) — so idle time between the call and arriving
// never eats into the requester's paid slot. See lib/roomQueue.ts.
model RoomQueueEntry {
  id          String    @id @default(cuid())
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  // null = a room-level queue (the whole restricted room). Non-null = a
  // queue scoped to one ZONE within an otherwise ordinary (or also
  // restricted) room — see ZoneRestriction below, added when "ruang CEO"
  // turned out to be a zone inside the shared office map, not a separate
  // Room. The two kinds never collide: advanceQueue/admitCalledEntry always
  // filter by this field, so a room-level queue and a zone-level queue in
  // the SAME room run fully independently.
  zoneId      String?
  // Snapshot at creation, same reasoning as `name` below (the requester's
  // own name) — avoids re-parsing Room.zones/layerData JSON just to label a
  // notice or an admin's queue list.
  zoneName    String?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  topic       String?
  // Chosen by the requester when they fill the form (not the admin) — see
  // lib/roomQueue.ts's QUEUE_MIN_MINUTES/QUEUE_MAX_MINUTES for the bounds
  // that keep one person from booking the whole day.
  durationMin Int
  status      String    @default("waiting")
  requestedAt DateTime  @default(now())
  calledAt    DateTime?
  startedAt   DateTime?
  endsAt      DateTime?
  completedAt DateTime?

  // The waiting-room position query (oldest 'waiting' first, scoped by
  // zoneId too) and the sweep's expiry scans (by status) are the only
  // queries this table serves.
  @@index([roomId, zoneId, status, requestedAt])
  @@index([userId, status])
}

// "CEO Office" turned out to be a ZONE inside the shared "Kaitech" map, not
// a separate Room — Room.restrictedAccess (above) gates walking into a
// whole different office and has no way to reach a sub-area of one you're
// already in. This is that same idea one level down: which zones (by
// Zone.id — a JSON entry in Room.zones/layerData, not a DB row of its own,
// hence zoneId being a bare string here rather than a relation) require
// staff+ or a queue ticket to enter. Independent of, and stackable with,
// zoneLock.ts's manual keyholder lock ("we're in a meeting, don't walk
// in") — that one is ephemeral/in-memory and anyone can set it; this one is
// persistent admin config, same posture as restrictedAccess itself.
model ZoneRestriction {
  id           String   @id @default(cuid())
  roomId       String
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  zoneId       String
  // Minimum RoomMember.role (see shared/permissions.ts's Role/ROLE_ORDER)
  // that bypasses the queue and may just walk in — reuses the room's own
  // RoomMember rows (the same ones Room.restrictedAccess's access-grant
  // endpoints manage), not a separate per-zone grant list, to avoid a
  // whole second admin UI just for this.
  minRole      String   @default("staff")
  // Whether a denied user may self-service via the queue form at all — off
  // means "staff+ only, no self-service path", same relationship
  // restrictedAccess/queueEnabled have at the room level.
  queueEnabled Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([roomId, zoneId])
}

// §4.1 — Teleport (Admin): staff+ role, shared across everyone with access
// to this room, max 20 per room (enforced in server/src/routes/teleport.ts,
// not here — Prisma doesn't do conditional insert limits). Unlike the
// spec's generic "Space" with multiple maps, a MeetKai Room IS the map, so
// these are scoped to one roomId only — no cross-map case exists here.
model TeleportLocation {
  id         String   @id @default(cuid())
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name       String
  x          Int
  y          Int
  icon       String?
  orderIndex Int
  createdBy  String
  createdAt  DateTime @default(now())

  @@index([roomId])
}

// §4.2 — Teleport (Owner): personal bookmarks, visible only to the room's
// own owner. Deliberately scoped by (ownerId, roomId) together with NO
// auto-copy across rooms — per the spec's own design note, a bookmark set
// in one room/map doesn't appear in another; the owner re-adds locations
// per room on purpose.
model OwnerBookmark {
  id         String   @id @default(cuid())
  ownerId    String
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  label      String
  x          Int
  y          Int
  orderIndex Int
  createdAt  DateTime @default(now())

  @@index([ownerId, roomId])
}

// §6 — Add Media. One table for every media type, `type` as discriminator
// (mirrors the spec's own "MapMediaObject" model) — `payload`'s shape
// depends on `type`, see MediaPayload in shared/types/index.ts. `portal`
// isn't a valid `type` here — this app's portal is a permanent Room Editor
// tile, not a media object (see the SocketEvents doc comment for why).
model MapMediaObject {
  id            String    @id @default(cuid())
  roomId        String
  room          Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  type          String
  x             Int
  y             Int
  createdBy     String
  // Captured once at creation from the live socket's display name — NOT
  // resolved lazily from createdBy later, since getPlayerName() is keyed by
  // socket id (which changes every reconnect and is meaningless once the
  // creator disconnects), not by this user id.
  createdByName String
  createdAt     DateTime  @default(now())
  // null = permanent (youtube, whiteboard). image/file get now+24h at
  // creation; a periodic sweep (see mediaHandler.ts) deletes expired rows
  // (and, for image/file, the uploaded file on disk) — there's no separate
  // job queue in this app to run a real cron against.
  expiresAt     DateTime?
  payload       Json

  @@index([roomId])
}

// Soundboard — custom short sound clips uploaded by any room member (not
// admin-gated, unlike the Room Editor's own uploads), visible to and
// playable by everyone in that room. Room-scoped like MapMediaObject above
// (no cross-room reuse), permanent (no expiresAt — a soundboard clip isn't
// ephemeral like a 24h media object). durationMs is validated server-side
// at upload time (see routes/soundboard.ts) and stored purely so the panel
// can show it; it is never re-validated at playback time.
model SoundboardSound {
  id            String   @id @default(cuid())
  roomId        String
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name          String
  url           String
  durationMs    Int
  createdBy     String
  // Same reasoning as MapMediaObject.createdByName — captured once at
  // upload time from the live socket's display name, not resolved lazily.
  createdByName String
  createdAt     DateTime @default(now())

  @@index([roomId])
}

// §7 — Screen Recording. Adapted from the spec's server-side/SFU-worker
// design to a client-side capture: this app's WebRTC is a mesh (§8's own
// scope decision), so raw media never touches the server at all — there's
// no stream for a server worker to subscribe to and encode. Instead the
// admin who starts the recording captures the target's already-decoded
// video (MediaRecorder on the incoming MediaStream, see webrtcService.ts's
// getRecordingStream) in their OWN browser and uploads the result when
// done. Real consequence of that trade-off: the recording does NOT survive
// the starting admin's tab closing/refreshing, unlike the spec's explicit
// "starter refresh tetap jalan" requirement — there's no server-side
// process to keep it alive independent of that browser tab.
model Recording {
  id                String    @id @default(cuid())
  roomId            String
  room              Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  startedBy         String
  // Captured at creation the same way MapMediaObject.createdByName is —
  // see that model's doc comment for why (getPlayerName is socket-id keyed).
  startedByName     String
  targetUserId      String
  targetName        String
  title             String
  // recording -> processing (Stop clicked, upload in flight) -> done
  // (uploaded successfully), or -> failed at any point if the starter
  // disconnects (see recordingHandler.ts's DISCONNECT handler — capture
  // genuinely dies with that browser tab).
  status            String    @default("recording")
  startedAt         DateTime  @default(now())
  endedAt           DateTime?
  fileUrl           String?
  // Set once status becomes "done": now + 3 days / 3 downloads, matching
  // the spec's own numbers even though there's no real S3 signed-URL here
  // (see routes/recordings.ts's own download-gate enforcing these).
  downloadExpiresAt DateTime?
  downloadCount     Int       @default(0)
  maxDownloads      Int       @default(3)

  @@index([roomId])
}

// Channel/DM/Thread chat — replaces the old whole-room ephemeral broadcast
// (see chatHandler.ts) with real persistence. Channels are per-Room (every
// room gets an auto-created, non-deletable "general" channel — see
// routes/rooms.ts's POST /rooms and routes/chat.ts's lazy backfill for
// rooms created before this existed). Zone-private chat and the proximity
// speech bubble are untouched — genuinely ephemeral, different feature.
model Channel {
  id        String        @id @default(cuid())
  roomId    String
  room      Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name      String
  isDefault Boolean       @default(false)
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
  reads     ChatRead[]

  @@unique([roomId, name])
}

// A 1:1 conversation scoped to the room both users are in — this app has no
// global cross-room friends list to hang a global DM on. userAId/userBId
// are always stored with userAId < userBId (string compare) so the same
// pair can never produce two rows regardless of who started it — see
// routes/chat.ts's findOrCreateDm.
model DirectConversation {
  id        String        @id @default(cuid())
  roomId    String
  room      Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userAId   String
  userBId   String
  userA     User          @relation("DMUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User          @relation("DMUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
  reads     ChatRead[]

  @@unique([roomId, userAId, userBId])
}

// Read receipts ("dibaca oleh X, Y, Z") — ONE row per (user, channel) or
// (user, DM), tracking how far they've read, not one row per message. A
// message is "seen by" whoever's lastReadAt is >= that message's createdAt —
// derived client-side from this one small per-thread map, rather than
// writing/shipping a row per message per reader (which would be the same
// user-visible result at a much heavier write/bandwidth cost — opening a
// 50-message channel would otherwise mean 50 writes instead of 1).
// Belongs to exactly one of Channel or DirectConversation, same convention
// as ChatMessage below — enforced in channelChatHandler.ts, not the DB.
model ChatRead {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId      String?
  channel        Channel?            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   DirectConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime            @default(now())

  @@unique([userId, channelId])
  @@unique([userId, conversationId])
}

// Belongs to exactly one of Channel or DirectConversation (never both).
// parentId is a self-relation for threaded replies — a top-level message has
// parentId null; a reply sets it to its parent's id. Threads are one level
// deep in the UI (ChatPanel doesn't nest replies-of-replies) but the schema
// itself doesn't need to enforce that.
model ChatMessage {
  id             String              @id @default(cuid())
  channelId      String?
  channel        Channel?            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   DirectConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         ChatMessage?        @relation("ThreadReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        ChatMessage[]       @relation("ThreadReplies")
  senderId       String
  sender         User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text           String
  // Optional file attachment — reuses the same POST /api/uploads endpoint
  // and storage as Add Media (server/src/routes/uploads.ts), so a chat
  // message with a file just carries the resulting URL here. attachmentName
  // is the ORIGINAL filename (the stored file itself is renamed to a random
  // UUID on disk), shown as the download label and used to pick an image
  // preview vs. a generic file icon client-side. A message can have text,
  // an attachment, or both — never neither (enforced in channelChatHandler.ts).
  attachmentUrl  String?
  attachmentName String?
  createdAt      DateTime            @default(now())

  // ── Messenger migration, step 2 (see Conversation below) ──────────
  // The new home for this message's thread. Nullable and populated by
  // backfill alongside channelId/conversationId, which stay authoritative
  // until every read path has moved over and been verified — so any step of
  // this migration can be rolled back by simply ignoring these two columns.
  conversationId2 String?
  conversationV2  Conversation? @relation("ConversationV2Messages", fields: [conversationId2], references: [id], onDelete: Cascade)

  // Sender-generated id for the send that produced this message. A messenger
  // has to survive a socket reconnect mid-send: without this, a client that
  // retries an unacked send has no way to say "this is the same message, not
  // a second one", and the retry silently double-posts. Null for every
  // backfilled row (they predate the concept) — Postgres allows unlimited
  // NULLs under a UNIQUE, so those rows don't collide with each other.
  clientId String?

  // Slack/Discord-style per-thread pin (SocketEvents.MESSAGE_PIN) — distinct
  // from the room-wide Notice board's own pin, a totally separate
  // admin-announcement feature. Open to anyone in the thread, not gated to
  // admins or the sender.
  isPinned Boolean @default(false)

  @@unique([conversationId2, clientId])
  @@index([channelId, createdAt])
  @@index([conversationId, createdAt])
  @@index([parentId])
  @@index([conversationId2, createdAt])
  // Looked up on every attachment download: GET /api/uploads/:filename
  // resolves a URL back to its message to decide who may read it (see
  // routes/uploads.ts). Without this, that check is a full scan of every
  // message ever sent, on every single image load.
  @@index([attachmentUrl])
}

// Bagian 4 — Two-way Lark ↔ MeetKai chat sync (channel/room ONLY, never DM
// or zone-private chat). One Lark group chat maps to one MeetKai room; the
// sync target is that room's default ("general") Channel. Both ids are unique:
// roomId so a room has at most one mapping, chatId so an inbound webhook can
// resolve the room from the Lark chat_id with a single indexed lookup.
model RoomChatMap {
  id        String   @id @default(cuid())
  roomId    String   @unique
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  // Lark group chat_id (e.g. "oc_xxx") this room mirrors.
  chatId    String   @unique
  // Cached Lark group name for display in the admin mapping UI — advisory only,
  // never used for routing (chatId is authoritative).
  chatName  String?
  // Cached room name, mirrors the spec's RoomChatMap shape; display-only.
  roomName  String
  createdAt DateTime @default(now())
}

// Bagian 4 — anti-echo ledger. Every message MeetKai sends OUT to Lark has its
// returned Lark message_id recorded here; the inbound webhook skips any event
// whose message_id is present, so a message we just relayed to Lark can't come
// back through the webhook and double-post in MeetKai. Rows are disposable —
// only recent ids matter (a message only ever echoes back within seconds), so
// createdAt is indexed for a cheap periodic prune.
model LarkSentMessage {
  id        String   @id @default(cuid())
  messageId String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ── Messenger migration, step 2: workspace-level conversations ────────
// Chat is currently pinned to a Room: Channel.roomId and
// DirectConversation.roomId are both required, both Cascade. That makes a DM
// a property of a room rather than of the two people in it — leave the room
// and the conversation goes with it. A workspace messenger can't work that
// way, so a Conversation deliberately has no required room.
//
// Added alongside Channel/DirectConversation rather than replacing them:
// every row here is derived by backfill, the old tables stay authoritative,
// and nothing reads these columns until step 3 verifies the backfill.
//
// id is DETERMINISTIC, not a cuid, so the backfill is idempotent — re-running
// it can only re-derive the same rows, never fork duplicates:
//   dm:<userAId>:<userBId>   with the pair sorted (userAId < userBId)
//   grp:<channelId>
// The sorted-pair form is also what finally makes a DM one conversation
// per PAIR instead of one per (pair, room). Verified against live data before
// choosing it: no pair currently holds DMs in more than one room, so this
// merges nothing that exists today — it only decides what happens next.
model Conversation {
  id    String  @id
  kind  String // 'dm' | 'group'
  title String? // group only — a DM is named after the other person

  // PROVENANCE ONLY — never an access boundary, and deliberately SetNull
  // rather than Cascade. A Cascade here would rebuild the exact bug this
  // model exists to fix: deleting a room would delete the DMs of people who
  // merely happened to talk while in it.
  //
  // Group conversations still resolve access through this room for now (see
  // routes/chat.ts's canAccessRoomChat). That is NOT laziness: 190 of 191
  // rooms are public, where chat is open to any authenticated user with no
  // RoomMember row at all. Gating groups on the participant list below would
  // silently lock every one of those rooms down — a product decision, not
  // something an additive migration gets to do as a side effect.
  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     ChatMessage[]             @relation("ConversationV2Messages")

  @@index([roomId])
  @@index([kind])
}

// Explicit membership — the thing that lets a conversation outlive the room
// it was born in. Authoritative for DMs (it encodes exactly the pair check
// routes/chat.ts already does today); informational for groups until group
// membership becomes a real product concept.
model ConversationParticipant {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())

  @@id([conversationId, userId])
  // "every conversation this user is in", the messenger's home screen query —
  // it has no room to scope by, which is the whole point.
  @@index([userId])
}
