node_modules/
dist/
.env
.env.local
# Plain `.env` only matches that exact name — a copy like
# `.env.backup-2026-08-12` would otherwise be committed WITH its credentials.
.env.backup*
.env.*.local
*.log
# TypeScript incremental build state — a build artifact, not source.
*.tsbuildinfo
.DS_Store
server/uploads/
# scripts/screenshotUI.mjs output — working reference images for a UI
# redesign pass, not something to version.
ui-screenshots/
test-results/
playwright-report/
# scripts/importLimeZuFull.mjs's zip-extraction scratch dir (cleaned up on
# success; a failed run can leave it behind).
.temp-limezu-extract/
backups/
# Real credentials — a plaintext email/password list for the DCM account
# batch (server/scripts/seedDcmAccounts.ts reads it directly at run time).
# Never commit.
DCM_Password_List.xlsx

# Database dumps and upload archives pulled off a server during the migration
# (kaitech-db.sql.gz, kaitech-uploads.tar.gz). These are real production data —
# every account, every session, every uploaded file — and they land in the repo
# root, one `git add -A` away from being published. Ignored by pattern rather
# than by name so the next restore does not have to remember to add its own.
# Anchored to the repo root with a leading slash, which is where a dump
# lands. An unanchored *.sql would also match server/prisma/migrations/*/
# migration.sql — the existing ones stay tracked, but every FUTURE migration
# would be silently ignored and the schema would drift on the next deploy.
/*.sql
*.sql.gz
*-uploads.tar.gz

# Windows NTFS alternate-data-stream markers, created whenever a downloaded
# file is copied into WSL. They sit next to the real file as
# "<name>:Zone.Identifier", carry nothing but the download's origin URL, and
# would otherwise ride along with every asset added this way.
*:Zone.Identifier
